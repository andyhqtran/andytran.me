{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":URL:",
                ":BUN:",
                ":NODE:",
                ":PACKAGE:",
                ":PACKAGE_WITH_PROTOCOL:"
              ],
              ":BLANK_LINE:",
              ":NODE:"
            ]
          }
        },
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "css": {
    "assist": {
      "enabled": true
    },
    "formatter": {
      "enabled": true
    },
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!.agents",
      "!.claude",
      "!openspec"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "enabled": true,
    "rules": {
      "nursery": {
        "useTailwindSortedClasses": {
          "fix": "safe",
          "level": "error"
        }
      },
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noUnusedTemplateLiteral": "error",
        "useConsistentTypeDefinitions": {
          "fix": "unsafe",
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useImportType": {
          "fix": "safe",
          "level": "error",
          "options": {
            "style": "inlineType"
          }
        },
        "useNamingConvention": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noUnknownAtRules": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "./*.ts",
        "./*.mjs",
        "**/app/**/page.tsx",
        "**/app/**/template.tsx",
        "**/app/**/layout.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "tailwind": {
    "attributes": ["class", "className", "classList"],
    "mergeFunctions": ["clsx", "classNames", "tw"],
    "variantFunctions": ["cva"]
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
